<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: tick, progress arc and rays from the supplied artwork. The group is scaled to 70% around the
     centre so the ring matches the 48dp icon keyline and the rays stay inside every launcher mask (the
     guaranteed-visible zone is the centre 66dp of 108dp). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.7"
        android:scaleY="0.7">
        <!-- Moves the ring's centre (49.3, 56.3) onto the canvas centre so the icon sits centred in every mask. -->
        <group
            android:translateX="4.7"
            android:translateY="-2.3">
            <path
                android:pathData="M76,72 A31,31 0 1 1 80,52"
                android:strokeWidth="8"
                android:strokeLineCap="round">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:startX="18.3"
                        android:startY="25.3"
                        android:endX="80.3"
                        android:endY="87.3"
                        android:type="linear">
                        <item android:color="#73FF9A" android:offset="0" />
                        <item android:color="#20D96D" android:offset="1" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:pathData="M30,53 L44,67 L74,35"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="10"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <group
                android:pivotX="79"
                android:pivotY="25.5"
                android:rotation="15">
                <path android:fillColor="#FFD84D" android:pathData="M77,22 a2,2 0 0 1 4,0 v7 a2,2 0 0 1 -4,0 z" />
            </group>
            <group
                android:pivotX="87"
                android:pivotY="33.5"
                android:rotation="45">
                <path android:fillColor="#FFD84D" android:pathData="M85,30 a2,2 0 0 1 4,0 v7 a2,2 0 0 1 -4,0 z" />
            </group>
            <path android:fillColor="#FFD84D" android:pathData="M88,42 a2,2 0 0 1 4,0 v5 a2,2 0 0 1 -4,0 z" />
        </group>
    </group>
</vector>
